# ── SnapCaption AI — Apache Security & Performance ───────────────────────────
# Root-level .htaccess for Hostinger shared hosting

# ── Force HTTPS ───────────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Redirect www → non-www (uncomment after domain is confirmed) ──────────────
# RewriteCond %{HTTP_HOST} ^www\.yourdomain\.com [NC]
# RewriteRule ^(.*)$ https://yourdomain.com/$1 [R=301,L]

# ── Block direct browser access to sensitive API files ────────────────────────
<FilesMatch "^(config|db)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block access to hidden files (.env, .git, etc.) ───────────────────────────
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-XSS-Protection          "1; mode=block"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set Permissions-Policy        "camera=(), microphone=(), geolocation=()"

    # Content Security Policy — tighten after launch if needed
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self';"
</IfModule>

# ── Gzip compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ── Browser caching for static assets ────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — short cache (app updates frequently)
    ExpiresByType text/html                        "access plus 1 hour"

    # Styles & scripts — 1 month (use cache-busting query strings on updates)
    ExpiresByType text/css                         "access plus 1 month"
    ExpiresByType application/javascript           "access plus 1 month"

    # Images — 1 year
    ExpiresByType image/jpeg                       "access plus 1 year"
    ExpiresByType image/png                        "access plus 1 year"
    ExpiresByType image/webp                       "access plus 1 year"
    ExpiresByType image/svg+xml                    "access plus 1 year"
    ExpiresByType image/x-icon                     "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/woff                        "access plus 1 year"
    ExpiresByType font/woff2                       "access plus 1 year"

    # PWA manifest & service worker
    ExpiresByType application/manifest+json        "access plus 1 day"
    ExpiresByType application/javascript           "access plus 0 seconds"
</IfModule>

# ── Prevent hotlinking of images ──────────────────────────────────────────────
# (Uncomment after domain is finalized)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https://(www\.)?yourdomain\.com/ [NC]
# RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC]

# ── Custom error pages ────────────────────────────────────────────────────────
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html
